            "id": "t00-032",
            "phase": "evidence",
            "lesson": 8,
            "lessonTitle": "Evidence Database",
            "speaker": "male-detective",
            "type": "dialogue",
            "text": "Whatever you find, jot a note on it. Future you will thank present you once the case gets complicated.",
