            "phase": "police-mail",
            "lesson": 7,
            "lessonTitle": "Police Mail",
            "speaker": "female-detective",
            "type": "dialogue",
            "text": "Nora Finch, the bookstore owner — till was short, and someone forced a locked display case. Straightforward enough to learn on.",
            "next": "t00-028"
        },
        {
            "id": "t00-028",
            "phase": "police-mail",
            "lesson": 7,
            "lessonTitle": "Police Mail",
            "speaker": "male-detective",
            "type": "dialogue",
            "text": "Reports like this almost always have attachments, and attachments almost always link straight to evidence. Worth opening every one.",
            "next": "t00-029"
        },
        {
            "id": "t00-029",
            "phase": "police-mail",
            "lesson": 7,
            "lessonTitle": "Police Mail",
            "speaker": "female-detective",
            "type": "instruction",
            "text": "Open the attachment on that report.",
            "requiredAction": {
                "event": "objective:completed",
                "match": { "objectiveId": "T00-04" }
            },
            "highlightTarget": ".mail__attachment-chip",
            "highlightScope": "window:police-mail",
            "next": "t00-030"
        },
